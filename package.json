{
  "name": "orbyt-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean",
    "dev:website": "pnpm --filter website dev",
    "dev:inbyte": "pnpm --filter innbite dev",
    "build:website": "pnpm --filter website build",
    "build:inbyte": "pnpm --filter innbite build",
    "lint:website": "pnpm --filter website lint",
    "lint:inbyte": "pnpm --filter innbite lint"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}

